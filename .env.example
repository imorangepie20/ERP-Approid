# Local development only. Copy this file to .env before running Compose.
# WARNING: These values are public examples. Never use them in production or shared environments.

COMPOSE_PROJECT_NAME=erp-approid

DB_NAME=erp_approid
DB_USERNAME=erp
DB_PASSWORD=erp_local_only_change_me
DB_HOST_PORT=15432

BACKEND_HOST_PORT=38080
FRONTEND_HOST_PORT=3000

# Per-container local log rotation. Production retention/export is an operator policy.
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# Public browser-facing URLs embedded in the Vite production build.
VITE_API_CORE_URL=http://127.0.0.1:38080/api/core
VITE_API_ANALYTICS_URL=http://127.0.0.1:38000/api/analytics

# Exact browser origins allowed to call the local Core API (comma-separated).
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Use independent, randomly generated secrets outside local development.
JWT_SECRET=erp-approid-local-jwt-secret-change-me-32bytes
INTERNAL_KEY=erp-approid-local-internal-key-change-me
