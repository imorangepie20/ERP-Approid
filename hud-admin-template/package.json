    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.0.5",
    "vitest": "^4.1.11"
